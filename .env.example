# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://crds:crds@localhost:5432/crds

# Redis (optional - uses in-memory channel layer if unset)
# REDIS_URL=redis://127.0.0.1:6379/0

# CRDS Monitoring
CRDS_WATCH_PATHS=
CRDS_EXTRA_DRIVES=
CRDS_RECURSIVE_MONITORING=true
CRDS_AUTO_START_MONITORING=false
CRDS_FEATURE_WINDOW_SECONDS=20

# Detection thresholds
CRDS_THRESHOLD_HIGH=0.75
CRDS_THRESHOLD_MEDIUM=0.5

# Hybrid scoring weights
CRDS_WEIGHT_AI=0.35
CRDS_WEIGHT_RULES=0.30
CRDS_WEIGHT_HONEYPOT=0.20
CRDS_WEIGHT_YARA=0.10
CRDS_WEIGHT_INTEL=0.05

# Automated response (dry-run by default for safety)
CRDS_RESPONSE_DRY_RUN=true
CRDS_RESPONSE_THRESHOLD=0.85
CRDS_RESP_KILL=false
CRDS_RESP_SUSPEND=false
CRDS_RESP_QUARANTINE=true
CRDS_RESP_BLOCK_HASH=true
CRDS_RESP_NET_ISOLATE=false
CRDS_RESP_PROTECT=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
